[user]
  name = Urosh Trifunovic
  email = 19859951+urosht@users.noreply.github.com
  AddKeysToAgent = yes
[github]
  user = urosht
  username = urosht
[credential]
  helper = cache
[core]
  editor = nvim
  excludesfile = ~/.gitignore_global
[diff]
  tool = vimdiff
[difftool]
  prompt = false
[alias]
  l = log --oneline
  ll = log --graph --date=relative --all --decorate
  s = status --short
  ss = status
[pull]
  rebase = false
[http]
  postBuffer = 524288000
