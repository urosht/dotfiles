[font]
normal = { family = "Mononoki Nerd Font Mono", style = "Regular" }
bold = { family = "Mononoki Nerd Font Mono", style = "Bold" }
italic = { family = "Mononoki Nerd Font Mono", style = "Italic" }
bold_italic = { family = "Mononoki Nerd Font Mono", style = "Bold Italic" }
size = 13.0

[font.offset]
x = 0
y = 0

[font.glyph_offset]
x = 0
y = 0

[window]
opacity = 1.0
dynamic_padding = false

[window.padding]
x = 8
y = 8

[cursor]
style = { shape = "Block", blinking = "Off" }

[scrolling]
history = 10000
multiplier = 3

[selection]
save_to_clipboard = true

[colors.primary]
background = "#1e1e1e"
foreground = "#d4d4d4"

[colors.cursor]
text = "#1e1e1e"
cursor = "#d4d4d4"

[colors.normal]
black = "#1e1e1e"
red = "#f48771"
green = "#a9dc76"
yellow = "#ffd866"
blue = "#78dce8"
magenta = "#ab9df2"
cyan = "#78dce8"
white = "#fcfcfa"

[colors.bright]
black = "#727072"
red = "#f48771"
green = "#a9dc76"
yellow = "#ffd866"
blue = "#78dce8"
magenta = "#ab9df2"
cyan = "#78dce8"
white = "#fcfcfa"

[env]
TERM = "xterm-256color"
